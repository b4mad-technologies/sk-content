{
  "name": "@spellkave/srd-cc",
  "version": "0.0.0",
  "private": true,
  "description": "SRD-CC content package with authored spatial-map fixtures and related source tooling.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./compendium": {
      "types": "./src/export/index.ts",
      "default": "./src/export/index.ts"
    },
    "./compendium/*": "./dist/compendium/*",
    "./docs/row-kind-coverage": {
      "types": "./src/docs/row-kind-coverage.ts",
      "default": "./src/docs/row-kind-coverage.ts"
    },
    "./docs/catalogue": {
      "types": "./src/docs/catalogue.ts",
      "default": "./src/docs/catalogue.ts"
    }
  },
  "files": [
    "src",
    "cache",
    "fixtures",
    "dist/compendium",
    "LICENSE.md",
    "NOTICE.md",
    "LICENSES"
  ],
  "scripts": {
    "generate": "tsx src/generate.ts && node ../../scripts/attach-notices.mjs srd",
    "export": "tsx src/export/cli.ts && node ../../scripts/attach-notices.mjs srd",
    "sync-cache": "tsx src/sync-cache.ts",
    "author:spatial-map-proofs": "tsx src/author/author-spatial-map-proofs.ts"
  },
  "dependencies": {
    "@spellkave/adventure-runtime": "workspace:*",
    "@spellkave/tool-authoring": "0.1.2",
    "@spellkave/tool-node": "0.1.2",
    "@spellkave/world-author": "0.1.2",
    "@spellkave/world-map": "0.1.2",
    "smol-toml": "^1.9.1",
    "tsx": "^4.19.2"
  },
  "license": "(CC-BY-4.0 AND PolyForm-Shield-1.0.0)",
  "devDependencies": {
    "@spellkave/sdk": "0.1.2",
    "@spellkave/session": "0.1.2",
    "@spellkave/tool-runtime": "0.1.2"
  }
}
